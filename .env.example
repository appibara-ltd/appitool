# ==============================================================================
# App Store Connect API Credentials
# ==============================================================================
APPLE_KEY_ID=2X9R4HXF34
APPLE_ISSUER_ID=57246542-96fe-1a63-e053-0824d011072a
# Path to your .p8 file (e.g., ~/.appstore/AuthKey_2X9R4HXF34.p8), raw PEM content, or Base64 string
APPLE_KEY=./AuthKey_2X9R4HXF34.p8
# Target iOS Application Bundle Identifier (e.g., com.example.app)
APPLE_BUNDLE_ID=com.example.app

# ==============================================================================
# Google Play Developer API Credentials
# ==============================================================================
# Path to your Google Service Account JSON key (e.g., ./service-account.json or ~/.google/service-account.json),
# raw JSON string, or Base64-encoded Service Account JSON content:
GOOGLE_KEY=./service-account.json
# Standard Google Cloud environment variable (alternative to GOOGLE_KEY):
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Target Android Application Package Name (e.g., com.example.app)
GOOGLE_PACKAGE_NAME=com.example.app

# ==============================================================================
# Firebase App Distribution Credentials (for AdHoc distribution)
# ==============================================================================
# Firebase App ID for iOS (format: 1:<project-number>:ios:<hash>)
FIREBASE_IOS_APP_ID=1:1234567890:ios:abcdef1234567890
# Firebase App ID for Android (format: 1:<project-number>:android:<hash>)
FIREBASE_ANDROID_APP_ID=1:1234567890:android:abcdef1234567890
# Optional Firebase CI token (alternative to GOOGLE_KEY service account)
# FIREBASE_TOKEN=your_firebase_cli_ci_token

# ==============================================================================
# Webhook Notifications (Slack, KokoNo)
# ==============================================================================
# Slack incoming webhook URL for flow success and failure alerts
SLACK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX
# KokoNo notification URL (format: https://kokono.me/notify?token=<token>)
KOKONO_URL=https://kokono.me/notify?token=your_kokono_token
# Optional KokoNo public key for end-to-end (E2E) encryption
KOKONO_E2E_PUBLIC_KEY=your_kokono_e2e_public_key
