# ==============================================================================
# App Store Connect API Credentials
# ==============================================================================
APPLE_KEY_ID=2X9R4HXF34
APPLE_ISSUER_ID=57246542-96fe-1a63-e053-0824d011072a
# Path to your .p8 file (e.g., ~/.appstore/AuthKey_2X9R4HXF34.p8), raw PEM content, or Base64 string
APPLE_KEY=./AuthKey_2X9R4HXF34.p8
# Target iOS Application Bundle Identifier (e.g., com.example.app)
APPLE_BUNDLE_ID=com.example.app
# Apple Developer Team ID (e.g., ABCDE12345)
APPLE_TEAM_ID=ABCDE12345

# ==============================================================================
# iOS XcodeBuild Configuration (Optional: auto-discovered if omitted)
# ==============================================================================
# Path to .xcworkspace (e.g. ./ios/App.xcworkspace)
# XCODE_WORKSPACE=./ios/App.xcworkspace
# Path to .xcodeproj (e.g. ./ios/App.xcodeproj)
# XCODE_PROJECT=./ios/App.xcodeproj
# Xcode scheme name to build
# XCODE_SCHEME=App
# Build configuration (Release or Debug, defaults to Release)
# XCODE_CONFIGURATION=Release
# Formatter tool for xcodebuild output (defaults to xcbeautify --renderer github-actions)
# XCODEBUILD_FORMATTER="xcbeautify --renderer github-actions"

# ==============================================================================
# Google Play Developer API Credentials
# ==============================================================================
# Path to your Google Service Account JSON key (e.g., ./service-account.json or ~/.google/service-account.json),
# raw JSON string, or Base64-encoded Service Account JSON content:
GOOGLE_KEY=./service-account.json

# Target Android Application Package Name (e.g., com.example.app)
GOOGLE_PACKAGE_NAME=com.example.app

# ==============================================================================
# Android Gradle & Keystore Configuration (Optional: for signing & custom paths)
# ==============================================================================
# Android root project directory (defaults to ./android if present, else .)
# ANDROID_PROJECT_DIR=./android
# Android product flavor (e.g. production, staging)
# ANDROID_FLAVOR=production
# Android build configuration / type (Release or Debug, defaults to Release)
# ANDROID_CONFIGURATION=Release
# Path to Android keystore file (e.g., ./android/app/release.keystore or ~/.android/release.keystore)
# ANDROID_KEYSTORE_PATH=./android/app/release.keystore
# Alternatively, base64-encoded keystore content:
# ANDROID_KEYSTORE=base64_encoded_keystore_string
# ANDROID_KEYSTORE_PASSWORD=your_keystore_password
# ANDROID_KEY_ALIAS=your_key_alias
# ANDROID_KEY_PASSWORD=your_key_password

# ==============================================================================
# Firebase App Distribution & Auth Credentials
# ==============================================================================
# Firebase / Google Cloud Project ID or Project Number (used by firebase group/user commands)
# FIREBASE_PROJECT_ID=your-firebase-project-id
# Firebase App ID for iOS (format: 1:<project-number>:ios:<hash>)
FIREBASE_IOS_APP_ID=1:1234567890:ios:abcdef1234567890
# Firebase App ID for Android (format: 1:<project-number>:android:<hash>)
FIREBASE_ANDROID_APP_ID=1:1234567890:android:abcdef1234567890

# ==============================================================================
# Webhook Notifications (Slack, KokoNo)
# ==============================================================================
# Slack incoming webhook URL for flow success and failure alerts
SLACK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX
# KokoNo notification URL (format: https://kokono.me/notify?token=<token>)
KOKONO_URL=https://kokono.me/notify?token=your_kokono_token
# Optional KokoNo public key for end-to-end (E2E) encryption
KOKONO_E2E_PUBLIC_KEY=your_kokono_e2e_public_key

# ==============================================================================
# GitHub Configuration (Optional: for private repository self-update)
# ==============================================================================
# GitHub Personal Access Token (classic or fine-grained token with 'repo' scope)
# Required only when checking updates or downloading releases from a private repo.
# GITHUB_TOKEN=ghp_your_github_personal_access_token

# ==============================================================================
# Match Code Signing Configuration (Git Storage & Encryption)
# ==============================================================================
# Git repository URL for certificates and profiles storage (HTTPS or SSH)
MATCH_GIT_URL=https://github.com/your-org/certificates.git
# Git branch name (defaults to master)
MATCH_GIT_BRANCH=master
# Git authentication token (Personal Access Token for HTTPS clone/push)
# MATCH_GIT_TOKEN=ghp_your_personal_access_token
# Passphrase used to decrypt and encrypt repository assets (AES-256-GCM / CBC)
MATCH_PASSWORD=secret_match_encryption_password
# Default Match profile type for `match ios` (appstore, development, adhoc, enterprise, developer_id)
# MATCH_TYPE=appstore
# Run Match in read-only mode during `flow` (defaults to true unless explicitly set to false)
# MATCH_READONLY=true
# Custom keychain name or path (defaults to appitool)
# MATCH_KEYCHAIN_NAME=appitool
# Custom keychain password (defaults to appipass)
# MATCH_KEYCHAIN_PASSWORD=appipass


